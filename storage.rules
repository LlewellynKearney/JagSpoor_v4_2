rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Authenticated users may read any object (marketplace trophy photos,
    // outfitter price-list scans, public profile pictures, etc.).
    match /{allPaths=**} {
      allow read: if request.auth != null;
    }

    // Per-user uploads: profile pictures, firearm photos, trophy photos,
    // hunter images. The second path segment is the owner's uid so writes
    // are scoped to the authenticated owner.
    match /users/{uid}/{fileName} {
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    match /firearm_photos/{uid}/{fileName} {
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    match /hunters/{uid}/{fileName} {
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    match /trophies/{uid}/{fileName} {
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    match /trophy_photos/{uid}/{fileName} {
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Outfitter-scoped uploads (price lists, package imagery). The outfitter's
    // uid is the second path segment.
    match /outfitters/{uid}/{fileName} {
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
