# JagSpoor Cloud Functions - Environment Variables
# Copy this file to .env (for local emulator) or set via Firebase CLI.
# Never commit the real .env file (it is gitignored).

# PayFast subscription billing (payfastSubscriptionITN webhook).
# Merchant passphrase used to verify ITN MD5 signatures. Defaults to the
# sandbox passphrase when unset; set the LIVE passphrase for production.
PAYFAST_PASSPHRASE=jagspoor_sandbox_2026

# PayFast server-to-server validation endpoint. Defaults to the sandbox
# endpoint; set the production endpoint for live billing.
PAYFAST_VALIDATE_URL=https://sandbox.payfast.co.za/eng/query/validate

# PayFast subscription cancellation (cancelSubscription endpoint).
# Merchant id used to sign the recurring-billing token termination call.
# Defaults to the sandbox merchant id when unset; set the LIVE merchant id
# for production.
PAYFAST_MERCHANT_ID=10053397

# PayFast subscriptions API base used by the token-termination call
# (POST {base}/v1/subscriptions/{token}/cancel). Defaults to the PRODUCTION
# API when unset; set the sandbox API base for sandbox testing.
#   Sandbox:    https://sandbox.payfast.co.za
#   Production: https://api.payfast.co.za
PAYFAST_API_BASE=https://sandbox.payfast.co.za


# Welcome email SMTP relay (initializeNewUserTrial Auth onCreate trigger).
# The transport settings are permanent hardcoded code defaults in
# src/user_trial_onboarding.ts (Brevo transactional relay over STARTTLS:
# smtp-relay.brevo.com:587, secure=false; sender "JagSpoor"
# <admin@jag-spoor.co.za>) — they are NOT env-configurable. Only the Brevo
# SMTP credentials are read from the environment: SMTP_PASS is linked to the
# Firebase Secret; never hardcode credentials in the source code.
# When SMTP_USER / SMTP_PASS are unset the trigger still initializes the
# trial and simply skips the email (dev/emulator friendly).
SMTP_USER=your-brevo-smtp-login@smtp-brevo.com
SMTP_PASS=


# Developer/tester trial-abuse exemption (initializeNewUserTrial trigger).
# Additional accounts (beyond the built-in TRIAL_ABUSE_EXEMPT_EMAILS list)
# whose hardware-fingerprint trial-abuse check is bypassed, so the team can
# register + test trial flows repeatedly from the same physical device.
# Comma-separated; leave empty in production unless actively testing.
TRIAL_EXEMPT_EMAILS=
TRIAL_EXEMPT_UIDS=
