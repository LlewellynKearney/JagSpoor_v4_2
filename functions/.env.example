# JagSpoor Cloud Functions - Environment Variables
# Copy this file to .env (for local emulator) or set via:
#   firebase functions:secrets set PAYFAST_PASSPHRASE   (recommended for production)
#   firebase functions:set PAYFAST_PASSPHRASE=...       (legacy runtime config)
# Never commit the real .env file (it is gitignored).

# ===========================================
# PAYFAST (Payment ITN handler)
# ===========================================
# The merchant "pass phrase" configured in PayFast settings (sandbox or live).
# Used to compute/verify the md5 signature on Instant Transaction Notifications.
# Optional but recommended; when unset, signatures are computed without a passphrase.
#
# Sandbox: set this to the pass phrase from your PayFast SANDBOX merchant account.
# Live:    set this to the pass phrase from your live PayFast merchant account.
PAYFAST_PASSPHRASE=

# ===========================================
# PAYFAST ENVIRONMENT (informational)
# ===========================================
# Whether the ITN handler should expect sandbox traffic. Currently the handler
# validates against https://www.payfast.co.za/eng/query/validate for both modes;
# PayFast sandbox ITNs are delivered from the same validate host. No code switch
# is required, but keep this flag in sync with the merchant account you are using.
PAYFAST_MODE=sandbox
