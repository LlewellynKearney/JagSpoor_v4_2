{
  "name": "jagspoor-functions",
  "description": "Firebase Cloud Functions for the JagSpoor marketplace (admin provisioning, FCM notifications, trial onboarding).",
  "private": true,
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "scripts": {
    "lint": "eslint --ext .ts src",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "seed:app-version": "npm run build && node lib/seed_app_version.js",
    "test": "npm run build && node --test test/*.test.js"
  },
  "dependencies": {
    "@google-cloud/pubsub": "^4.11.0",
    "@googleapis/androidpublisher": "^42.0.0",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.0.1",
    "google-auth-library": "^11.1.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
