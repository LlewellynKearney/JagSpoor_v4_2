<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Required for Google Play Billing subscriptions (in_app_purchase). -->
    <uses-permission android:name="com.android.vending.BILLING" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- NO broad media permissions are declared by JagSpoor.
         Specifically there is NO android.permission.READ_MEDIA_IMAGES,
         NO READ_MEDIA_VIDEO and NO READ_EXTERNAL_STORAGE.
         Google Play's "Photo and Video Permissions" policy (enforced
         2026-10-12, https://support.google.com/googleplay/android-developer/answer/13537402)
         permits those permissions only for apps whose CORE functionality is
         photo/video browsing or management. JagSpoor's need (pick a profile /
         trophy / firearm / package photo) is fully served by the Android
         system Photo Picker, which grants per-file access with NO runtime
         permission at all.
         image_picker 1.2.1 (image_picker_android 0.8.13+1) automatically
         routes to ActivityResultContracts.PickVisualMedia on Android 13+
         (API 33+) and uses the backported Photo Picker on Android 11/12 when
         the device supports it; on older devices it falls back to
         ACTION_OPEN_DOCUMENT / ACTION_GET_CONTENT, which also grant per-file
         access without a storage permission. Camera capture uses the CAMERA
         permission declared above.
         Do NOT re-add READ_MEDIA_IMAGES / READ_MEDIA_VIDEO /
         READ_EXTERNAL_STORAGE: doing so re-triggers the Play policy
         violation. See AGENTS.md ("Android photo picker") for the rationale.

         The three `tools:node="remove"` directives below STRIP storage /
         phone-state permissions that the TensorFlow Lite GPU delegate AAR
         (`com.google.ai.edge.litert:litert-gpu-api`, pulled in transitively
         by `tflite_flutter`) causes the manifest merger to IMPLY: that AAR
         ships NO <uses-sdk>, so the merger treats its targetSdkVersion as
         < 4 and auto-adds WRITE_EXTERNAL_STORAGE + READ_PHONE_STATE (and, in
         turn, READ_EXTERNAL_STORAGE). JagSpoor needs none of them - photos
         come from the system Photo Picker and the app only ever reads its
         own app-internal files. `tools:node="remove"` deletes them from the
         final merged manifest regardless of origin. Verified against the
         merged manifest after `flutter build apk`: none of the three survive
         (see the manifest-merger report, which otherwise reports them as
         "IMPLIED ... reason: org.tensorflow.lite.gpu.api has a
         targetSdkVersion < 4"). -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        tools:node="remove" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        tools:node="remove" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE"
        tools:node="remove" />
    <!-- Calendar read/write for the "Add Hunt to Calendar" feature
         (BookingCalendarService). These are "dangerous" permissions on
         Android 6+ (API 23+) so they require a runtime grant in addition
         to this manifest declaration; the runtime request is issued by
         BookingCalendarService.addToCalendar via the permission_handler
         package (Permission.calendar covers BOTH read + write on Android). -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    
    <application
        android:label="jagspoor"
        android:name="${applicationName}"
        android:icon="@mipmap/launcher_icon">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Referral App Links (post-Dynamic-Links).
                 https://jag-spoor.co.za/r/<CODE> is an Android App Link
                 (autoVerify=true): Android checks
                 https://jag-spoor.co.za/.well-known/assetlinks.json against
                 this app's signing certificate before opening the app
                 directly. The jagspoor:// custom scheme is the fallback for
                 an installed app whose association has not been verified yet
                 / an OEM that did not auto-verify. Firebase Dynamic Links
                 (jagspoor.page.link) was shut down on 2025-08-25. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data
                    android:scheme="https"
                    android:host="jag-spoor.co.za"
                    android:pathPrefix="/r"/>
                <data
                    android:scheme="https"
                    android:host="jag-spoor.co.za"
                    android:pathPrefix="/.well-known"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="jagspoor" android:host="referral"/>
            </intent-filter>
        </activity>
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>
</manifest>
