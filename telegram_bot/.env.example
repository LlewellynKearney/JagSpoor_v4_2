# JagSpoor Telegram Bot - Environment Variables
# Copy this file to .env and fill in your values

# ===========================================
# REQUIRED
# ===========================================

# Your Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=7734509027:AAGZApa6VdfipsHSqxJ0zvOrBgr2nRFtWUg

# ===========================================
# FIREBASE (Optional - for production)
# ===========================================

# Firebase service account JSON as a single-line string
# Replace newlines with \n in the JSON
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Or use path to service account file
# FIREBASE_SERVICE_ACCOUNT_PATH=./service_account.json

# ===========================================
# WEBHOOK (For webhook mode)
# ===========================================

# Your public HTTPS URL where the bot is hosted
# WEBHOOK_URL=https://your-domain.com

# Secret token for webhook verification (auto-generated if not set)
# WEBHOOK_SECRET=your_secure_webhook_secret

# Server port
PORT=8080
