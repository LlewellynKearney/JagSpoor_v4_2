rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isOutfitter() {
      return isSignedIn() && request.auth.token.role == 'outfitter';
    }

    // Animals - public read
    match /animals/{animalId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Firearms - owner can read/write
    match /firearms/{firearmId} {
      allow read, write: if isSignedIn();
    }

    // Trophies
    match /trophies/{trophyId} {
      allow read, write: if isSignedIn();
    }

    // Users
    match /users/{userId} {
      allow read, write: if isSignedIn();
    }

    match /users {
      allow list: if isSignedIn();
    }

    // Catalog - read by authenticated
    match /factory_ammunition/{docId} {
      allow read: if isSignedIn();
    }
    match /bullets/{docId} {
      allow read: if isSignedIn();
    }
    match /propellants/{docId} {
      allow read: if isSignedIn();
    }

    // LICENSE APPLICATIONS - Allow all authenticated users full access
    match /license_applications/{docId} {
      allow read, write: if isSignedIn();
    }

    // Carcass logs
    match /carcass_logs/{docId} {
      allow read, write: if isSignedIn();
    }

    // Waypoints
    match /waypoints/{docId} {
      allow read, write: if isSignedIn();
    }

    // PACKAGES - Allow all authenticated users to read
    match /packages/{packageId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // BOOKINGS - Allow all authenticated users full access
    match /bookings/{bookingId} {
      allow read, write: if isSignedIn();
    }

    // LODGING - Allow all authenticated users full access
    match /lodging/{lodgingId} {
      allow read, write: if isSignedIn();
    }

    // FLEET - Allow all authenticated users full access
    match /fleet/{vehicleId} {
      allow read, write: if isSignedIn();
    }

    // Farms
    match /farms/{farmId} {
      allow read, write: if isSignedIn();
    }

    // Farm managers
    match /farm_managers/{managerId} {
      allow read, write: if isSignedIn();
    }

    // Transport permits
    match /transport_permits/{permitId} {
      allow read, write: if isSignedIn();
    }

    // Scanned pricelists
    match /scanned_pricelists/{listId} {
      allow read, write: if isSignedIn();
    }

    // Ammunition inventory
    match /ammunition/{docId} {
      allow read, write: if isSignedIn();
    }

    // Spoor scans
    match /spoor_scans/{docId} {
      allow read, write: if isSignedIn();
    }

    // Outfitter sub-collections
    match /outfitter/bookings/{bookingId} {
      allow read, write: if isSignedIn();
    }
    match /outfitter/lodging/{unitId} {
      allow read, write: if isSignedIn();
    }
    match /outfitter/fleet/{vehicleId} {
      allow read, write: if isSignedIn();
    }

    // Managers
    match /managers/{managerId} {
      allow read, write: if isSignedIn();
    }

    // Records
    match /records/{recordId} {
      allow read, write: if isSignedIn();
    }

    // Assets
    match /assets/{assetId} {
      allow read, write: if isSignedIn();
    }

    // Units
    match /units/{unitId} {
      allow read, write: if isSignedIn();
    }

    // Chats
    match /chats/{chatId} {
      allow read, write: if isSignedIn();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
