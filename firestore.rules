rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {


    function isSignedIn() {
      return request.auth != null;
    }


    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }


    // SA Game Guide — global catalogue, readable by ANYONE (even offline/unauthenticated).
    // Writes are strictly locked down to administrators.
    match /animals/{animalId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }


    // Root firearms collection - users can only read/write their own firearms
    match /firearms/{firearmId} {
      allow read, update, delete: if isSignedIn() && request.auth.uid == resource.data.ownerId;
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.ownerId;

      // Allow read/write access to nested ammunition variants belonging to this firearm
      match /ammunition/{ammoId} {
        allow read, write: if isSignedIn() && request.auth.uid == get(/databases/$(database)/documents/firearms/$(firearmId)).data.ownerId;
      }
    }


    // Trophies - users can read/write if signed in
    match /trophies/{trophyId} {
      allow read, write: if isSignedIn();
    }


    // User profile documents - users can read/write their own document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Cascade permissions downward into firearms and nested ammunition tracks
      match /firearms/{firearmId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        
        match /ammunition/{ammoId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }


      // Custom loads - users can read/write their own custom loads
      match /custom_loads/{loadId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }


    // User collection queries - allow bounded collection queries with limit 1 for initialization
    match /users {
      allow list: if request.auth != null && request.query.limit <= 1;
    }


    // Maintain global access to static ammunition databases
    match /factory_ammunition/{docId} {
      allow read: if request.auth != null;
    }
    match /bullets/{docId} {
      allow read: if request.auth != null;
    }
    match /propellants/{docId} {
      allow read: if request.auth != null;
    }


    // ==========================================
    // 💳 SAPS LICENSE & COMPETENCY TRACKER PERMISSIONS
    // ==========================================
    match /license_applications/{docId} {
      allow read, write: if request.auth != null && (resource == null || resource.data.hunterId == request.auth.uid || request.resource.data.hunterId == request.auth.uid);
    }


    // ==========================================
    // 🥩 SLAUGHTERHOUSE CARCASS MATRIX PERMISSIONS
    // ==========================================
    match /carcass_logs/{docId} {
      allow read, write: if request.auth != null && (resource == null || resource.data.hunterId == request.auth.uid || request.resource.data.hunterId == request.auth.uid);
    }


    // ==========================================
    // 📍 OFFLINE FIELD WAYPOINT PLACER RULES
    // ==========================================
    match /waypoints/{docId} {
      allow read, write: if request.auth != null && (resource == null || resource.data.hunterId == request.auth.uid || request.resource.data.hunterId == request.auth.uid);
    }


    // ==========================================
    // 🏕️ OUTFITTER PACKAGE & BOOKING SYSTEM MATRIX
    // ==========================================
    match /packages/{packageId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && (resource == null || resource.data.outfitterId == request.auth.uid || request.resource.data.outfitterId == request.auth.uid);
    }


    match /bookings/{bookingId} {
      allow read: if request.auth != null && (
        resource.data.hunterId == request.auth.uid || 
        resource.data.outfitterId == request.auth.uid || 
        isManagerOfFarm(resource.data.farmId)
      );
      allow update: if request.auth != null && (
        resource.data.outfitterId == request.auth.uid || 
        isManagerOfFarm(resource.data.farmId)
      );
      allow create: if request.auth != null;
    }


    // ==========================================
    // 🏡 MULTI-FARM CONCESSION & MANAGER ROLES MATRIX
    // ==========================================
    match /farms/{farmId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && (resource == null || resource.data.outfitterId == request.auth.uid || request.resource.data.outfitterId == request.auth.uid);
    }


    match /farm_managers/{managerId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null;
    }

    // ==========================================
    // 🏕️ ENTERPRISE ROLE-BASED ACCESS CONTROL (RBAC)
    // ==========================================
    
    // Helper function to check if the authenticated user is a manager assigned to this specific farm
    function isManagerOfFarm(farmId) {
      return request.auth != null && 
        exists(/databases/$(database)/documents/farm_managers/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/farm_managers/$(request.auth.uid)).data.farmId == farmId;
    }


    match /farms/{farmId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && (resource == null || resource.data.outfitterId == request.auth.uid || request.resource.data.outfitterId == request.auth.uid);
    }


    match /packages/{packageId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && (resource == null || resource.data.outfitterId == request.auth.uid || request.resource.data.outfitterId == request.auth.uid);
    }


    match /bookings/{bookingId} {
      allow read: if request.auth != null && (
        resource.data.hunterId == request.auth.uid || 
        resource.data.outfitterId == request.auth.uid || 
        isManagerOfFarm(resource.data.farmId)
      );
      allow update: if request.auth != null && (
        resource.data.outfitterId == request.auth.uid || 
        isManagerOfFarm(resource.data.farmId)
      );
      allow create: if request.auth != null;
    }


    match /trophies/{trophyId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && (
        resource == null || 
        resource.data.outfitterId == request.auth.uid || 
        isManagerOfFarm(resource.data.farmId) ||
        request.resource.data.outfitterId == request.auth.uid ||
        isManagerOfFarm(request.resource.data.farmId)
      );
    }


    match /transport_permits/{permitId} {
      allow read: if request.auth != null && (
        resource.data.outfitterId == request.auth.uid || 
        isManagerOfFarm(resource.data.farmId)
      );
      allow write: if request.auth != null && (
        resource == null || 
        resource.data.outfitterId == request.auth.uid || 
        isManagerOfFarm(resource.data.farmId) ||
        request.resource.data.outfitterId == request.auth.uid ||
        isManagerOfFarm(request.resource.data.farmId)
      );
    }

    // ==========================================
    // 📸 AI-DRIVEN SCANNED PRICE LIST & CUSTOM PACKAGES
    // ==========================================
    match /scanned_pricelists/{listId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && (resource == null || resource.data.outfitterId == request.auth.uid || request.resource.data.outfitterId == request.auth.uid);
    }
  }
}
