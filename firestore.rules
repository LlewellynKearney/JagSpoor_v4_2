rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // HELPER FUNCTIONS
    // ==========================================
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isManagerOfFarm(farmId) {
      return request.auth != null && 
        exists(/databases/$(database)/documents/farm_managers/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/farm_managers/$(request.auth.uid)).data.farmId == farmId;
    }

    function isOwner'sData(fieldName) {
      return resource == null || resource.data[fieldName] == request.auth.uid;
    }

    function isOwner'sOrNull(fieldName) {
      return resource == null || resource.data[fieldName] == request.auth.uid || request.resource.data[fieldName] == request.auth.uid;
    }

    // ==========================================
    // 📱 USER PROFILES
    // ==========================================
    
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }

    // ==========================================
    // 🔫 FIREARMS & AMMUNITION
    // ==========================================
    
    match /firearms/{firearmId} {
      allow read: if isSignedIn() && isOwner'sData('ownerId');
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      
      // Nested ammunition sub-collection
      match /ammunition/{ammoId} {
        allow read, write: if isSignedIn() && get(/databases/$(database)/documents/firearms/$(firearmId)).data.ownerId == request.auth.uid;
      }
    }

    // User's ammunition inventory
    match /ammunition/{docId} {
      allow read, write: if isSignedIn() && isOwner'sData('ownerId');
    }

    // ==========================================
    // 🎯 BALLISTICS CATALOG (Read-only for users)
    // ==========================================
    
    match /factory_ammunition/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /bullets/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /propellants/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ==========================================
    // 🦌 WILDLIFE DATABASE
    // ==========================================
    
    match /animals/{animalId} {
      allow read: if true;  // Public read for offline access
      allow write: if isAdmin();
    }

    // ==========================================
    // 🏆 TROPHIES
    // ==========================================
    
    match /trophies/{trophyId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (isOwner'sData('hunterId') || isOwner'sData('outfitterId'));
    }

    // ==========================================
    // 📄 LICENSE APPLICATIONS (SAPS)
    // ==========================================
    
    match /license_applications/{docId} {
      allow read, write: if isSignedIn() && isOwner'sOrNull('hunterId');
    }

    // ==========================================
    // 🚗 TRANSPORT PERMITS
    // ==========================================
    
    match /transport_permits/{docId} {
      allow read, write: if isSignedIn() && isOwner'sOrNull('hunterId');
    }

    // ==========================================
    // 🥩 CARCASS LOGS
    // ==========================================
    
    match /carcass_logs/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (isOwner'sOrNull('hunterId') || isOwner'sOrNull('outfitterId'));
    }

    // ==========================================
    // 📍 WAYPOINTS & SPOOR
    // ==========================================
    
    match /waypoints/{docId} {
      allow read, write: if isSignedIn() && isOwner'sOrNull('userId');
    }

    match /spoor_scans/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isOwner'sOrNull('userId');
    }

    // ==========================================
    // 🏕️ OUTFITTER BOOKINGS (Root level)
    // ==========================================
    
    match /bookings/{bookingId} {
      allow read: if isSignedIn() && (isOwner'sData('hunterId') || isOwner'sData('outfitterId') || isManagerOfFarm(resource.data.farmId));
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (isOwner'sData('outfitterId') || isManagerOfFarm(resource.data.farmId));
      allow delete: if isSignedIn() && isOwner'sData('outfitterId');
      
      // Nested chats under booking
      match /chats/{messageId} {
        allow read, write: if isSignedIn();
      }
    }

    // ==========================================
    // 🏨 OUTFITTER sub-collections (/outfitter/bookings, /outfitter/lodging, /outfitter/fleet)
    // ==========================================
    
    // Outfitter Bookings (sub-collection path)
    match /outfitter/bookings/{bookingId} {
      allow read: if isSignedIn() && (isOwner'sData('outfitterId') || isOwner'sData('hunterId'));
      allow create, update, delete: if isSignedIn() && isOwner'sData('outfitterId');
    }
    
    // Outfitter Lodging
    match /outfitter/lodging/{unitId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isOwner'sOrNull('ownerId');
    }
    
    // Outfitter Fleet
    match /outfitter/fleet/{vehicleId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isOwner'sOrNull('ownerId');
    }

    // ==========================================
    // 🏡 FARMS & MANAGERS
    // ==========================================
    
    match /farms/{farmId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isOwner'sOrNull('ownerId');
    }

    match /farm_managers/{managerId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /managers/{managerId} {
      allow read, write: if isSignedIn();
    }

    // ==========================================
    // 📦 PACKAGES
    // ==========================================
    
    match /packages/{packageId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isOwner'sOrNull('outfitterId');
    }

    // ==========================================
    // 💬 CHATS
    // ==========================================
    
    match /chats/{chatId} {
      allow read, write: if isSignedIn();
    }

    // ==========================================
    // 📋 RECORDS & ASSETS
    // ==========================================
    
    match /records/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isOwner'sOrNull('ownerId');
    }

    match /assets/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isOwner'sOrNull('ownerId');
    }

    match /units/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isOwner'sOrNull('ownerId');
    }

    // ==========================================
    // 📸 SCANNED PRICE LISTS
    // ==========================================
    
    match /scanned_pricelists/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isOwner'sOrNull('userId');
    }

    // ==========================================
    // DEFAULT DENY
    // ==========================================
    
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
