rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Auth helper functions ────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    // Admin access recognizes three sources so the client-side AdminAuthGuard
    // (custom claim, email allow-list, or users/{uid}.role == 'admin') and the
    // server-side rules stay consistent:
    //   1. The `admin == true` custom claim on the ID token.
    //   2. The official admin email allow-list (token.email).
    //   3. A `role == 'admin'` field on the caller's users/{uid} document.
    // The get() is evaluated server-side and is not itself subject to read
    // rules; if the users doc is absent, .data.role resolves to null (false).
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'admin@jag-spoor.co.za' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    function isOutfitter() {
      return isSignedIn() && request.auth.token.role == 'outfitter';
    }

    // True when the caller's uid matches the document's owner field.
    // `resource` is null on create, so fall back to the incoming
    // request.resource.data for create operations.
    function isOwnerOf(ownerField) {
      return isSignedIn() && (
        (resource != null && resource.data[ownerField] == request.auth.uid) ||
        (resource == null && request.resource.data[ownerField] == request.auth.uid)
      );
    }

    // Owner-or-admin scope for strictly private user data collections.
    // isOwnerOf is checked first so a normal owner access never triggers the
    // users-doc get() inside isAdmin(); admin access falls through to it.
    function ownerOrAdmin(ownerField) {
      return isOwnerOf(ownerField) || isAdmin();
    }

    // Booking party check that works for the booking document itself
    // (uses resource / request.resource).
    function isBookingParty() {
      return isSignedIn() && (
        resource.data.hunterId == request.auth.uid ||
        resource.data.outfitterId == request.auth.uid
      );
    }

    // ── Marketplace / catalog (readable by any signed-in user) ──────────
    // SA Game Guide catalog (`animals`). Public read (the game guide works
    // offline + unauthenticated for reference). Write is split so the
    // startup `seedAnimalsFromCSV()` seeder (run from `main.dart` for every
    // signed-in user, forced via the `game_guide_seed_version` version tag)
    // can populate / overwrite the full benchmark dataset (official
    // Rowland Ward minimum + measurement method + horn description +
    // scientific name) on existing installs without a permission-denied.
    // Delete stays admin-only so the catalog can never be wiped by a
    // non-admin. (v4.5 to-do Item #6.)
    match /animals/{animalId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Basic user profiles: readable by any signed-in user (marketplace
    // display names), writable only by the owner.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }
    match /users {
      allow list: if isSignedIn();
    }

    // Outfitter profiles (created by adminCreateOutfitter Cloud Function).
    match /outfitters/{outfitterId} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow update, delete: if isAdmin() || isOwnerOf('uid');
    }

    // Catalog reference data — ballistics ammunition / bullet / propellant
    // databases seeded once at first launch by `BallisticsSeeder.seedAll()`
    // (invoked from `main.dart` for every signed-in user, gated by a
    // SharedPreferences `ballistics_seeded` flag). The seeder writes the
    // app's bundled CSV reference data with `set(merge: true)` using
    // deterministic doc ids derived from brand+caliber+grain, so seeding is
    // idempotent and concurrent seeds never clobber each other.
    //
    // Read: any signed-in user (ballistic calculator pickers, marketplace).
    // Create / update: any signed-in user — this is what eliminates the
    // `PERMISSION_DENIED: Missing or insufficient permissions` error during
    // startup seeding for non-admin users (the previous `write: isAdmin()`
    // gate blocked the one-time reference-data seed for every hunter /
    // outfitter on first launch). These collections hold static read-only
    // catalog reference data (no PII, no financial data), and there is no
    // UI path that writes to them outside the seeder, so authenticated
    // create/update is the minimal permission needed to seed them.
    // Delete: admin only — a non-admin must never be able to wipe the
    // shared ballistics catalog.
    match /factory_ammunition/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }
    match /bullets/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }
    match /propellants/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Packages (marketplace listings): browsable by any signed-in user;
    // only the owning outfitter may create/update/delete. A signed-in hunter
    // is additionally permitted to decrement `quantityAvailable` (and flip
    // the status to `sold_out` when it reaches 0) inside the atomic booking
    // transaction in `PackageBookingManager.bookPackage` — this is tightly
    // scoped so a hunter can ONLY lower the slot count (never raise it) and
    // cannot tamper with price/identity fields.
    match /packages/{packageId} {
      function isOwner() {
        return isSignedIn()
          && resource.data.outfitterId == request.auth.uid;
      }
      // A hunter booking the package may only: lower quantityAvailable by >=1,
      // optionally set status to 'sold_out', and bump updatedAt. Every other
      // field (price, title, outfitter identity) must be unchanged.
      function isInventoryDecrement() {
        return isSignedIn()
          && request.resource.data.outfitterId == resource.data.outfitterId
          && request.resource.data.title == resource.data.title
          && request.resource.data.basePriceRands == resource.data.basePriceRands
          && request.resource.data.totalPriceZAR == resource.data.totalPriceZAR
          && request.resource.data.quantityAvailable
              < resource.data.quantityAvailable
          && (request.resource.data.status == resource.data.status
              || request.resource.data.status == 'sold_out');
      }
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.outfitterId == request.auth.uid;
      allow update: if isOwner() || isInventoryDecrement();
      allow delete: if isOwner();
    }

    // ── PRIVATE USER DATA (strictly owner-scoped) ───────────────────────
    // No other user (signed-in or not) may read or write another user's
    // records. Admins retain full access for support/oversight.

    // Firearms inventory (ownerId). Owner-scoped reads/writes; the nested
    // ammunition subcollection inherits owner scoping from the parent firearm.
    match /firearms/{firearmId} {
      allow read, write: if ownerOrAdmin('ownerId');

      // Ammunition variations scoped to this firearm. Readable/writable by the
      // firearm owner (for load-type selection / ballistics). The rule checks
      // the parent firearm's ownerId so existing ammo docs (which historically
      // were not stamped with their own ownerId) remain accessible, while new
      // docs may also carry an `ownerId` for a direct check.
      match /ammunition/{ammoId} {
        allow read, write: if isSignedIn() && (
          get(/databases/$(database)/documents/firearms/$(firearmId)).data.ownerId == request.auth.uid
          || request.resource.data.ownerId == request.auth.uid
          || isAdmin()
        );
      }
    }

    // Optic save audit log — one document per "Save Optic" event in the
    // Optical Suite. Stamped `userId` == auth.uid. Read + write are owner-
    // scoped so a hunter can review their own saved optics + configuration
    // changes but cannot read another hunter's log. Admin full access.
    match /optic_logs/{logId} {
      // Read accepts BOTH owner-field aliases: the canonical `userId` and the
      // legacy `ownerId` (the history stream queries `userId OR ownerId`).
      allow read: if isAdmin()
        || isOwnerOf('userId')
        || isOwnerOf('ownerId');
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin()
        || isOwnerOf('userId')
        || isOwnerOf('ownerId');
    }

    // Hunter personal trophies (Digital Trophy Room) — stamped `ownerId`.
    // Read is open to any signed-in user so a hunter can share their trophy
    // room. Writes are restricted to the owning hunter (or an admin). The
    // outfitter's saleable trophy stock inventory lives in a SEPARATE
    // `trophy_stock` collection (see below) so the two concerns never collide.
    // Owner fields accepted: ownerId (personal), hunterId/userId (legacy
    // aliases). outfitterId is accepted too only for backward-compat with
    // legacy stock docs that have not been migrated.
    match /trophies/{trophyId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin()
        || isOwnerOf('ownerId')
        || isOwnerOf('outfitterId')
        || isOwnerOf('hunterId')
        || isOwnerOf('userId');
    }

    // Outfitter trophy stock inventory (marketplace listings) — stamped
    // `outfitterId` with `farmId` + `availableCount` + `pricePerTrophyRands`.
    // Distinct from the hunter's personal Digital Trophy Room (`trophies`
    // above) so the outfitter's saleable inventory never collides with a
    // hunter's harvested trophy log. Read is open to any signed-in user so
    // the Trophy Registry & marketplace can display outfitter stock to
    // hunters. Writes are restricted to the owning outfitter (or an admin),
    // PLUS a tightly-scoped hunter-decrement allowance (mirrors `packages`):
    // the hunter's atomic booking transaction (`PackageBookingManager
    // .bookTrophyStock`) decrements `availableCount` (and flips the status to
    // `sold_out` when it reaches 0); every price/species/farm/identity field
    // must be unchanged, so a hunter can ONLY lower the stock count (never
    // raise it) and cannot tamper with pricing.
    match /trophy_stock/{trophyId} {
      function isOwner() {
        return isSignedIn()
          && resource.data.outfitterId == request.auth.uid;
      }
      // A hunter booking one animal out of the stock may only: lower
      // `availableCount`, optionally set status to 'sold_out', and bump
      // `lastUpdated`. Every other field (price, species, farmId, outfitter
      // identity) must be unchanged.
      function isStockDecrement() {
        return isSignedIn()
          && request.resource.data.outfitterId == resource.data.outfitterId
          && request.resource.data.species == resource.data.species
          && request.resource.data.farmId == resource.data.farmId
          && request.resource.data.pricePerTrophyRands
              == resource.data.pricePerTrophyRands
          && request.resource.data.availableCount
              < resource.data.availableCount
          && (request.resource.data.status == resource.data.status
              || request.resource.data.status == 'sold_out');
      }
      allow read: if isSignedIn();
      allow create: if ownerOrAdmin('outfitterId');
      allow update: if isOwner() || isStockDecrement() || isAdmin();
      allow delete: if ownerOrAdmin('outfitterId');
    }

    // Per-farm game price lists (outfitterId). Each entry is a single
    // game-species line item (species name + qty + price in ZAR) linked to a
    // farmId and stamped with the owning outfitter's uid. Read is open to any
    // signed-in user (so the marketplace / custom-package builder can display
    // a farm's pricing); writes are owner-scoped (the owning outfitter or an
    // admin).
    match /farm_pricelists/{entryId} {
      allow read: if isSignedIn();
      allow create, update, delete: if ownerOrAdmin('outfitterId');
    }

    // Itemized service-rate configuration per farm (outfitterId). One document
    // per farm (id == farmId) holding the 7 standard service rates. Readable
    // by any signed-in user (so hunters/custom-package builders can see the
    // rate card); writes owner-scoped.
    match /farm_service_rates/{farmId} {
      allow read: if isSignedIn();
      allow create, update, delete: if ownerOrAdmin('outfitterId');
    }

    // Ammunition inventory (ownerId). Top-level collection is readable by any
    // signed-in user (catalog/load-type selection); writes owner-scoped. Most
    // ammunition is stored as a subcollection of firearms (see below).
    match /ammunition/{docId} {
      allow read: if isSignedIn();
      allow write: if ownerOrAdmin('ownerId');
    }

    // License applications (hunterId).
    match /license_applications/{docId} {
      allow read, write: if ownerOrAdmin('hunterId');
    }

    // Carcass logs (hunterId).
    match /carcass_logs/{docId} {
      allow read, write: if ownerOrAdmin('hunterId');
    }

    // Meat processing / slaughterhouse orders (hunterId).
    match /meat_processing_orders/{orderId} {
      allow read, write: if ownerOrAdmin('hunterId');
    }

    // Waypoints (hunterId).
    match /waypoints/{docId} {
      allow read, write: if ownerOrAdmin('hunterId');
    }

    // Transport permits — issued by the outfitter (outfitterId).
    match /transport_permits/{permitId} {
      allow read, write: if ownerOrAdmin('outfitterId');
    }

    // ── Role-partitioned venison / game transport & hunt permits ──
    // The single shared `venison_permits` collection is split into two
    // partitions so each role queries its own collection without permission
    // conflicts: `outfitter_venison_permits` (filterable by `outfitterId`)
    // and `hunter_venison_permits` (filterable by `hunterId`). Both
    // partitions carry the full permit document under the SAME document id
    // (dual-write at issue time), so reads/updates/deletes stay in sync.
    match /outfitter_venison_permits/{permitId} {
      // Read: the issuing outfitter (queryable for `.where('outfitterId',
      // isEqualTo: uid)`), the designated hunter (via `hunterId` OR its
      // dual-stamped `userId` alias), or an admin.
      allow read: if isSignedIn() && (
        resource.data.outfitterId == request.auth.uid ||
        resource.data.hunterId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      // Create / update: any signed-in user may write permit data (both the
      // outfitter and the hunter co-complete the legal form + signatures),
      // so outfitters and authorized users can generate venison transport
      // permits without hitting PERMISSION_DENIED.
      allow create, update: if isSignedIn();
      // Delete: only the issuing outfitter or an admin (least-privilege).
      allow delete: if isOwnerOf('outfitterId') || isAdmin();
    }

    match /hunter_venison_permits/{permitId} {
      // Read: the designated hunter (queryable for the
      // Filter.or(`hunterId` == uid, `userId` == uid) list query — the
      // server evaluates this rule against every returned doc and guarantees
      // each satisfies at least one field condition), the issuing outfitter,
      // or an admin.
      allow read: if isSignedIn() && (
        resource.data.hunterId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        resource.data.outfitterId == request.auth.uid ||
        isAdmin()
      );
      // Create / update: any signed-in user (both parties co-complete the
      // legal form + signatures).
      allow create, update: if isSignedIn();
      // Delete: only the issuing outfitter or an admin (least-privilege).
      allow delete: if isOwnerOf('outfitterId') || isAdmin();
    }

    // Venison / game transport & hunt permits — two-party (hunter + outfitter).
    // LEGACY pre-partition shared collection (read-fallback only; no longer
    // written). Read: the hunter named on the permit OR the issuing outfitter
    // (or admin). Create: any signed-in party (either role may initiate a
    // permit). Update / delete: outfitter or admin — the outfitter is the
    // statutory issuer.
    match /venison_permits/{permitId} {
      // Read: any signed-in user who is a party to the permit (the
      // outfitter who issued it via `outfitterId`, or the hunter it was
      // issued to via `hunterId` OR its `userId` alias -- both are
      // dual-stamped at issue time) or an admin. The hunter-side
      // list/stream query uses Filter.or(`hunterId` == uid, `userId` == uid),
      // which succeeds because the server evaluates this rule against every
      // returned doc and guarantees each one satisfies at least one field
      // condition. The `userId` branch also keeps legacy docs (which only
      // carried the `userId` alias) readable by the designated hunter.
      allow read: if isSignedIn() && (
        resource.data.outfitterId == request.auth.uid ||
        resource.data.hunterId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      // Create / update: any signed-in user may write permit data (both the
      // outfitter and the hunter co-complete the legal form + signatures),
      // so outfitters and authorized users can generate venison transport
      // permits without hitting PERMISSION_DENIED.
      allow create, update: if isSignedIn();
      // Delete: only the issuing outfitter or an admin (least-privilege).
      allow delete: if isOwnerOf('outfitterId') || isAdmin();
    }

    // Scanned price lists. Active lists are the catalog hunters build custom
    // packages from (analogous to `packages`), so any signed-in hunter may
    // READ them. Writes remain owner-scoped to the issuing outfitter (the
    // `ownerOrAdmin('outfitterId')` check still guards create/update/delete).
    // This unblocks the Custom Package Builder farm-selection filter and the
    // species/line-item picker. Deploy: `firebase deploy --only firestore:rules`.
    match /scanned_pricelists/{listId} {
      allow read: if isSignedIn();
      allow create, update, delete: if ownerOrAdmin('outfitterId');
    }

    // Spoor scans (userId). Private to the scanning hunter.
    match /spoor_scans/{docId} {
      allow read, write: if ownerOrAdmin('userId');
    }

    // Generic records (ownerId).
    match /records/{recordId} {
      allow read, write: if ownerOrAdmin('ownerId');
    }

    // ── Bookings ─────────────────────────────────────────────────────────
    // Read: the hunter who placed the booking, the outfitter who owns the
    // package, a farm manager assigned to the booking's farm (enterprise
    // access — single-doc reads via a farm_managers/{uid} lookup), or an
    // admin. The outfitter read is the enterprise query path: an
    // authenticated user whose uid matches `outfitterId` on the booking
    // document may read/query bookings where they are the outfitter.
    // Create: the hunter placing it (hunterId must be caller).
    // Update: outfitter may flip the status field; either party may update
    //         non-status fields.
    // Delete: admin only.
    match /bookings/{bookingId} {
      // The hunter who placed the booking.
      function isBookingHunter() {
        return isSignedIn() && resource.data.hunterId == request.auth.uid;
      }
      // The outfitter who owns the package on the booking. This is the
      // enterprise query path: the outfitter's dashboard runs
      // `.where('outfitterId', isEqualTo: currentUserId)`, and Firestore's
      // query-based security validates that the query constrains `outfitterId`
      // to `request.auth.uid` -- exactly the field this function checks --
      // so the outfitter may LIST their own bookings.
      function isBookingOutfitter() {
        return isSignedIn() && resource.data.outfitterId == request.auth.uid;
      }
      // Hunter OR outfitter on the booking (the two booking parties). Used
      // for both single-doc reads and the hunter's
      // `.where('hunterId', isEqualTo: uid)` / outfitter's
      // `.where('outfitterId', isEqualTo: uid)` list queries.
      function isBookingParty() {
        return isBookingHunter() || isBookingOutfitter();
      }
      // Farm manager assigned to the booking's farm (enterprise access).
      // Looks up `farm_managers/{uid}` and grants read when the manager's
      // assigned `farmId` matches the booking's `farmId`. This covers
      // single-doc reads (e.g. the calendar package-fallback fetch). NOTE:
      // a get()-based rule is not directly queryable for the manager's
      // `.where('farmId', isEqualTo: assignedFarmId)` LIST query, so the
      // manager dashboard should resolve the parent outfitter and query by
      // `outfitterId` (which IS queryable via isBookingOutfitter) -- see
      // the dashboard's manager branch comment.
      function isFarmManagerForBooking() {
        return isSignedIn() &&
          get(/databases/$(database)/documents/farm_managers/$(request.auth.uid))
            .data.farmId == resource.data.farmId;
      }
      // Only the outfitter may change the status field. This prevents a
      // hunter from self-approving their own booking.
      function statusUpdateAllowed() {
        return isSignedIn()
          && resource.data.outfitterId == request.auth.uid
          && request.resource.data.outfitterId == resource.data.outfitterId
          && request.resource.data.hunterId == resource.data.hunterId;
      }
      allow read: if isAdmin() || isBookingParty() || isFarmManagerForBooking();
      allow create: if isSignedIn()
        && request.resource.data.hunterId == request.auth.uid;
      allow update: if statusUpdateAllowed()
        || (isBookingParty()
            && request.resource.data.status == resource.data.status);
      allow delete: if isAdmin();
    }

    // ── Operational collections (outfitter-scoped) ──────────────────────
    // Farms are owned by an outfitter (outfitterId).
    match /farms/{farmId} {
      allow read: if isSignedIn();
      allow create: if isOwnerOf('outfitterId');
      allow update, delete: if isAdmin() || isOwnerOf('outfitterId');
    }

    // Farm managers are scoped to the issuing outfitter (outfitterId).
    // Read: any signed-in user — matches the farms/lodging/fleet pattern so
    // the outfitter dashboard / enterprise panel can list a manager without a
    // PERMISSION_DENIED crash when the manager doc's outfitterId does not
    // match the caller (e.g. a manager reading their own assignment, or an
    // admin viewing the roster). Writes remain owner-scoped.
    match /farm_managers/{managerId} {
      allow read: if isSignedIn();
      allow create: if isOwnerOf('outfitterId');
      allow update, delete: if isAdmin() || isOwnerOf('outfitterId');
    }

    // Lodging / fleet are outfitter-operational. Reads for signed-in users
    // (marketplace availability); writes restricted to outfitters/admin.
    match /lodging/{lodgingId} {
      allow read: if isSignedIn();
      allow write: if isOutfitter() || isAdmin();
    }
    match /fleet/{vehicleId} {
      allow read: if isSignedIn();
      allow write: if isOutfitter() || isAdmin();
    }

    // Legacy nested outfitter sub-collections (outfitter-only access).
    match /outfitter/bookings/{bookingId} {
      allow read, write: if isOutfitter() || isAdmin();
    }
    match /outfitter/lodging/{unitId} {
      allow read, write: if isOutfitter() || isAdmin();
    }
    match /outfitter/fleet/{vehicleId} {
      allow read, write: if isOutfitter() || isAdmin();
    }

    // ── Admin-managed collections ───────────────────────────────────────
    match /managers/{managerId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /assets/{assetId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isOwnerOf('ownerId');
    }
    match /units/{unitId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── User feedback / bug reports ─────────────────────────────────────
    // Any authenticated user may submit a new report (create). Report
    // documents carry the submitter's `hunterId`, so reads/edits/deletes are
    // restricted to admins to protect user privacy and to let the support
    // team manage the inbound queue. isAdmin() covers the
    // `request.auth.token.admin == true` custom claim plus the email
    // allow-list and users/{uid}.role == 'admin' sources used by
    // AdminAuthGuard, keeping server- and client-side admin detection
    // consistent.
    match /bug_reports/{reportId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }
    match /feature_suggestions/{suggestionId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }

    // ── Default deny ────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
