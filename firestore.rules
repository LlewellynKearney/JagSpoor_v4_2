rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Auth helper functions ────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isOutfitter() {
      return isSignedIn() && request.auth.token.role == 'outfitter';
    }

    // True when the caller's uid matches the document's ownerId field.
    // After-write resource is null on create; fall back to the incoming
    // request.resource.data for create operations.
    function isOwnerOf(ownerField) {
      return isSignedIn() && (
        (resource != null && resource.data[ownerField] == request.auth.uid) ||
        (resource == null && request.resource.data[ownerField] == request.auth.uid)
      );
    }

    // ── Animals - public read, admin write only ──────────────────────────
    match /animals/{animalId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Firearms - owner-scoped read & write ─────────────────────────────
    match /firearms/{firearmId} {
      allow read, write: if isOwnerOf('ownerId');
    }

    // ── Trophies - owner-scoped read & write ─────────────────────────────
    match /trophies/{trophyId} {
      allow read, write: if isOwnerOf('hunterId');
    }

    // ── Users ────────────────────────────────────────────────────────────
    match /users/{userId} {
      // A user may read any authenticated user's basic profile (marketplace
      // needs to show outfitter/hunter display names) but may only write
      // their own document.
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    match /users {
      allow list: if isSignedIn();
    }

    // Outfitter profile documents created by the adminCreateOutfitter
    // Cloud Function. Readable by any signed-in user (marketplace), only
    // the owning outfitter (uid field) or an admin may write.
    match /outfitters/{outfitterId} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow update, delete: if isAdmin() || isOwnerOf('uid');
    }

    // ── Catalog - read by authenticated ─────────────────────────────────
    match /factory_ammunition/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /bullets/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /propellants/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── License applications ─────────────────────────────────────────────
    match /license_applications/{docId} {
      allow read, write: if isSignedIn();
    }

    // ── Carcass logs ─────────────────────────────────────────────────────
    match /carcass_logs/{docId} {
      allow read, write: if isSignedIn();
    }

    // ── Waypoints ───────────────────────────────────────────────────────
    match /waypoints/{docId} {
      allow read, write: if isSignedIn();
    }

    // ── Packages (marketplace listings) ─────────────────────────────────
    // Anyone signed in may browse; only the owning outfitter may create,
    // update or delete their own packages.
    match /packages/{packageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.outfitterId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.outfitterId == request.auth.uid;
    }

    // ── Bookings ─────────────────────────────────────────────────────────
    // Read: hunter who placed the booking OR outfitter who owns the package.
    // Create: the hunter placing it (hunterId must be caller).
    // Update: outfitter may flip the status field; the hunter may update
    //         non-status fields. The PayFast ITN Cloud Function uses the
    //         Admin SDK so it bypasses these rules entirely.
    // Delete: admin only.
    match /bookings/{bookingId} {
      function isBookingParty() {
        return isSignedIn() && (
          resource.data.hunterId == request.auth.uid ||
          resource.data.outfitterId == request.auth.uid
        );
      }
      // Only the outfitter may change the status field. This prevents a
      // hunter from self-approving their own booking.
      function statusUpdateAllowed() {
        return isSignedIn()
          && resource.data.outfitterId == request.auth.uid
          && request.resource.data.outfitterId == resource.data.outfitterId
          && request.resource.data.hunterId == resource.data.hunterId;
      }
      allow read: if isBookingParty();
      allow create: if isSignedIn() && request.resource.data.hunterId == request.auth.uid;
      allow update: if statusUpdateAllowed()
        || (isBookingParty()
            && request.resource.data.status == resource.data.status);
      allow delete: if isAdmin();

      // Negotiation chat subcollection: any authenticated user (parent
      // booking fields are not accessible from the subcollection match, so
      // party-scoping via isBookingParty() is not enforceable here).
      match /chats/{chatId} {
        allow read, write: if request.auth != null;
      }
    }

    // ── Lodging ─────────────────────────────────────────────────────────
    match /lodging/{lodgingId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // ── Fleet ───────────────────────────────────────────────────────────
    match /fleet/{vehicleId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // ── Farms ───────────────────────────────────────────────────────────
    match /farms/{farmId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    // ── Farm managers ────────────────────────────────────────────────────
    match /farm_managers/{managerId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // ── Transport permits ───────────────────────────────────────────────
    match /transport_permits/{permitId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.hunterId == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.hunterId == request.auth.uid || isAdmin());
    }

    // ── Scanned pricelists ──────────────────────────────────────────────
    match /scanned_pricelists/{listId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // ── Ammunition inventory ─────────────────────────────────────────────
    match /ammunition/{docId} {
      allow read, write: if isOwnerOf('ownerId');
    }

    // ── Spoor scans ─────────────────────────────────────────────────────
    match /spoor_scans/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // ── Outfitter sub-collections (legacy nested paths) ─────────────────
    match /outfitter/bookings/{bookingId} {
      allow read, write: if isSignedIn();
    }
    match /outfitter/lodging/{unitId} {
      allow read, write: if isSignedIn();
    }
    match /outfitter/fleet/{vehicleId} {
      allow read, write: if isSignedIn();
    }

    // ── Generic admin collections ──────────────────────────────────────
    match /managers/{managerId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /records/{recordId} {
      allow read, write: if isOwnerOf('ownerId');
    }
    match /assets/{assetId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isOwnerOf('ownerId');
    }
    match /units/{unitId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── Chats (top-level) ───────────────────────────────────────────────
    match /chats/{chatId} {
      allow read, write: if isSignedIn();
    }

    // ── Default deny ────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
