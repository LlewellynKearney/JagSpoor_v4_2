rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isOutfitter() {
      return isSignedIn() && request.auth.token.role == 'outfitter';
    }

    // Animals - public read
    match /animals/{animalId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Firearms
    match /firearms/{firearmId} {
      allow read, update, delete: if isSignedIn() && request.auth.uid == resource.data.ownerId;
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.ownerId;

      match /ammunition/{ammoId} {
        allow read, write: if isSignedIn() && request.auth.uid == get(/databases/$(database)/documents/firearms/$(firearmId)).data.ownerId;
      }
    }

    // Trophies
    match /trophies/{trophyId} {
      allow read, write: if isSignedIn();
    }

    // Users
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /firearms/{firearmId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        match /ammunition/{ammoId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }

      match /custom_loads/{loadId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /users {
      allow list: if request.auth != null && request.query.limit <= 1;
    }

    // Catalog - read by authenticated
    match /factory_ammunition/{docId} {
      allow read: if request.auth != null;
    }
    match /bullets/{docId} {
      allow read: if request.auth != null;
    }
    match /propellants/{docId} {
      allow read: if request.auth != null;
    }

    // License applications
    match /license_applications/{docId} {
      allow read, write: if request.auth != null;
    }

    // Carcass logs
    match /carcass_logs/{docId} {
      allow read, write: if request.auth != null;
    }

    // Waypoints
    match /waypoints/{docId} {
      allow read, write: if request.auth != null;
    }

    // Packages
    match /packages/{packageId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null;
    }

    // BOOKINGS - Hunters can read their own
    match /bookings/{bookingId} {
      allow read: if request.auth != null && (resource.data.hunterId == request.auth.uid || resource.data.outfitterId == request.auth.uid);
      allow update: if request.auth != null && resource.data.outfitterId == request.auth.uid;
      allow create: if request.auth != null;
      allow delete: if request.auth != null && resource.data.outfitterId == request.auth.uid;

      match /chats/{messageId} {
        allow read, write: if request.auth != null;
      }
    }

    // LODGING - All can read, outfitters can write
    match /lodging/{lodgingId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isOutfitter();
    }

    // FLEET - Hunters can read, outfitters can write
    match /fleet/{vehicleId} {
      allow read: if request.auth != null && (resource.data.hunterId == request.auth.uid || resource.data.outfitterId == request.auth.uid);
      allow write: if request.auth != null && isOutfitter();
    }

    // Farms
    match /farms/{farmId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null;
    }

    // Farm managers
    match /farm_managers/{managerId} {
      allow read, write: if request.auth != null;
    }

    // Transport permits
    match /transport_permits/{permitId} {
      allow read, write: if request.auth != null;
    }

    // Scanned pricelists
    match /scanned_pricelists/{listId} {
      allow read, write: if request.auth != null;
    }

    // Ammunition inventory
    match /ammunition/{docId} {
      allow read, write: if request.auth != null;
    }

    // Spoor scans
    match /spoor_scans/{docId} {
      allow read, write: if request.auth != null;
    }

    // Outfitter sub-collections
    match /outfitter/bookings/{bookingId} {
      allow read, write: if request.auth != null;
    }
    match /outfitter/lodging/{unitId} {
      allow read, write: if request.auth != null;
    }
    match /outfitter/fleet/{vehicleId} {
      allow read, write: if request.auth != null;
    }

    // Managers
    match /managers/{managerId} {
      allow read, write: if request.auth != null;
    }

    // Records
    match /records/{recordId} {
      allow read, write: if request.auth != null;
    }

    // Assets
    match /assets/{assetId} {
      allow read, write: if request.auth != null;
    }

    // Units
    match /units/{unitId} {
      allow read, write: if request.auth != null;
    }

    // Chats
    match /chats/{chatId} {
      allow read, write: if request.auth != null;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
