rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Authentication verification helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // User management
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    match /users {
      allow list: if request.auth != null && request.query.limit <= 1;
    }

    // Public data - read-only
    match /animals/{animalId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /trophies/{trophyId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Firearms collection with owner-based permissions
    match /firearms/{firearmId} {
      allow read, update, delete: if isSignedIn() && request.auth.uid == resource.data.ownerId;
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.ownerId;
      
      // Firearms ammunition sub-collection
      match /ammunition/{ammoId} {
        allow read, write: if isSignedIn();
      }
    }

    // Ballistics inventory collections
    match /firearm_safe/{document} {
      allow read, write: if isSignedIn();
    }
    
    match /ammunition/{document} {
      allow read, write: if isSignedIn();
    }

    // Global ballistic catalogues
    match /factory_ammunition/{docId} {
      allow read, write: if isSignedIn();
    }
    
    match /bullets/{docId} {
      allow read, write: if isSignedIn();
    }
    
    match /propellants/{docId} {
      allow read, write: if isSignedIn();
    }

    // Bug Reports collection - Hunter feedback system v12.3
    match /bug_reports/{reportId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.hunterId);
    }

    // Feature Suggestions collection - Hunter feedback system v12.3
    match /feature_suggestions/{suggestionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.hunterId);
    }

    // ==========================================
    // 💳 SAPS LICENSE & COMPETENCY TRACKER PERMISSIONS
    // ==========================================
    match /license_applications/{docId} {
      allow read: if request.auth != null && resource.data.hunterId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.hunterId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.hunterId == request.auth.uid;
    }

    // Outfitter sub-collection tracking layout
    match /outfitter/{docId} {
      allow read, write: if isSignedIn();
      
      match /{subCollection}/{subDocId} {
        allow read, write: if isSignedIn();
      }
    }

    // Catch-all for any other documents
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
